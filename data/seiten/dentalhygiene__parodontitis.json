   "titel": "Häufige Fragen zu Parodontitis und Dentalhygiene",
   "fragen": [
    {
     "_key": "f87",
     "frage": "Ist Parodontose heilbar?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b88",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s89",
         "text": "Parodontose ist nicht vollständig heilbar, aber sehr gut kontrollierbar. Mit regelmässiger Dentalhygiene kann die Krankheit gestoppt werden.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8a",
     "frage": "Ist Parodontose schlimm?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8b",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8c",
         "text": "Ja – unbehandelt kann sie zu Zahnverlust führen und steht im Zusammenhang mit allgemeinen Gesundheitsrisiken.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8d",
     "frage": "Tut die Behandlung weh?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8e",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8f",
         "text": "Die Behandlung ist heute schonend und gut verträglich. Empfindliche Stellen werden individuell berücksichtigt.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8g",
     "frage": "Wie entsteht Parodontose?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8h",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8i",
         "text": "Durch Bakterien im Zahnbelag, oft begünstigt durch unzureichende Mundhygiene, Rauchen, Stress und genetische Veranlagung.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8j",
     "frage": "Kann ich Parodontose selbst behandeln?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8k",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8l",
         "text": "Nein. Die Bakterien unter dem Zahnfleisch können nur professionell entfernt werden.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8m",
     "frage": "Wie oft muss ich zur Dentalhygiene bei Parodontose?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8n",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8o",
         "text": "In der Regel alle 3–6 Monate, je nach Schweregrad.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8p",
     "frage": "Ist Mundgeruch ein Zeichen für Parodontose?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8q",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8r",
         "text": "Ja – oft ein frühes Warnsignal durch bakterielle Entzündungen.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8s",
     "frage": "Können sich Zähne bei Parodontose wieder festigen?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8t",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8u",
         "text": "Wenn früh behandelt wird: ja, teilweise Stabilisierung möglich.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8v",
     "frage": "Was passiert, wenn ich bei Parodontose nichts mache?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8w",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s8x",
         "text": "Fortschreitender Knochenabbau, Zahnlockerung, Zahnverlust.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f8y",
     "frage": "Ist Parodontose ansteckend?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b8z",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s90",
         "text": "Bakterien können übertragen werden (z. B. über Speichel), aber das Risiko hängt stark von der individuellen Mundgesundheit ab.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f91",
     "frage": "Übernimmt die Krankenkasse die Behandlung?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b92",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s93",
         "text": "In der Schweiz meist nicht standardmässig, ausser bei Zusatzversicherungen.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f94",
     "frage": "Hilft eine elektrische Zahnbürste bei Parodontose?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b95",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s96",
         "text": "Ja – sie unterstützt die tägliche Pflege, ersetzt aber keine professionelle Behandlung. Nach Ansicht der Praxis ist eine Ultraschallzahnbürste die noch bessere Wahl.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    },
    {
     "_key": "f97",
     "frage": "Hilft eine Ultraschallzahnbürste bei Parodontose?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b98",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s99",
         "text": "Nach Angabe der Praxis kann Ultraschall wie bei der MEGASONEX M8 helfen, indem er Bakterienstrukturen im Biofilm auch in tieferen Zahnfleischtaschen zerstört und so die Keimlast reduziert – unterstützend zur normalen Zahnpflege, nicht als Ersatz für eine Behandlung. Mehr im Ratgeber ",
         "marks": []
        },
        {
         "_type": "span",
         "_key": "s9b",
         "text": "Ultraschallzahnbürste",
         "marks": [
          "l9a"
         ]
        },
        {
         "_type": "span",
         "_key": "s9c",
         "text": ".",
         "marks": []
        }
       ],
       "markDefs": [
        {
         "_type": "link",
         "_key": "l9a",
         "href": "/ratgeber/ultraschallzahnbuerste/",
         "extern": false
        }
       ]
      }
     ]
    },
    {
     "_key": "f9d",
     "frage": "Welche Rolle spielt die Dentalhygienikerin langfristig?",
     "antwort": [
      {
       "_type": "block",
       "_key": "b9e",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s9f",
         "text": "Sie ist entscheidend für die Kontrolle der Entzündung, die Prävention von Rückfällen und den langfristigen Zahnerhalt.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
    }
   ]
