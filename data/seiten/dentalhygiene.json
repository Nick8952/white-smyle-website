       "_type": "block",
       "_key": "b2u",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "_key": "s2v",
         "text": "Die Häufigkeit hängt von Ihrer individuellen Situation ab. Empfehlung der Praxis: 1–2 Mal pro Jahr bei gesunden Zähnen, 3–4 Mal pro Jahr bei Parodontitis oder erhöhtem Risiko wie bei Raucherinnen und Rauchern.",
         "marks": []
        }
       ],
       "markDefs": []
      }
     ]
